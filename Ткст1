
#!/bin/bash

# Скрипт установки Arch Linux в dual-boot с Windows
# Запускать от root после загрузки с установочного носителя Arch

# Цвета для вывода
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Функция для вывода сообщений
print_message() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARNING]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Проверка, что скрипт запущен от root
if [ "$EUID" -ne 0 ]; then
    print_error "Пожалуйста, запустите скрипт от root"
    exit 1
fi

# Проверка наличия интернета
print_message "Проверка подключения к интернету..."
if ! ping -c 3 archlinux.org &> /dev/null; then
    print_error "Нет подключения к интернету"
    exit 1
fi

# Обновление системных часов
print_message "Обновление системных часов..."
timedatectl set-ntp true

# Определение NVMe диска
print_message "Поиск NVMe дисков..."
NVME_DEVICES=$(lsblk -d -o NAME,TYPE | grep nvme | awk '{print $1}')
if [ -z "$NVME_DEVICES" ]; then
    print_error "NVMe диск не найден"
    exit 1
fi

# Выбор NVMe диска (обычно первый)
NVME_DEVICE="/dev/$(echo $NVME_DEVICES | head -n1)"
print_message "Найден NVMe диск: $NVME_DEVICE"

# Показываем текущие разделы
print_message "Текущие разделы на диске:"
lsblk $NVME_DEVICE

# Поиск Windows разделов
print_message "Поиск Windows разделов..."
WINDOWS_PART=$(lsblk -o NAME,FSTYPE,LABEL $NVME_DEVICE | grep -E "ntfs|vfat" | grep -i "system" | head -n1 | awk '{print $1}')
if [ -z "$WINDOWS_PART" ]; then
    print_warning "Не удалось автоматически найти системный раздел Windows"
    print_message "Продолжаем с ручным определением..."
else
    print_message "Найден системный раздел Windows: /dev/$WINDOWS_PART"
fi

# Создание разделов
print_message "Создание разделов..."
print_warning "Будет создан раздел для Arch Linux на свободном месте"
print_warning "Убедитесь, что на диске есть свободное место!"

# Получаем информацию о диске
DISK_SIZE=$(blockdev --getsize64 $NVME_DEVICE)
DISK_SIZE_GB=$((DISK_SIZE / 1024 / 1024 / 1024))
print_message "Размер диска: ${DISK_SIZE_GB}GB"

# Использование sgdisk для создания раздела на свободном месте
print_message "Создание разделов на свободном месте..."
sgdisk -E $NVME_DEVICE > /tmp/start_sector.txt
START_SECTOR=$(cat /tmp/start_sector.txt)
END_SECTOR=$(sgdisk -E $NVME_DEVICE)

# Создание нового раздела
print_message "Создание раздела для Arch Linux..."
sgdisk -n 0:$START_SECTOR:0 -t 0:8300 -c 0:"ArchLinux" $NVME_DEVICE

# Обновление информации о разделах
partprobe $NVME_DEVICE
sleep 2

# Определение нового раздела
ARCH_PART="${NVME_DEVICE}p$(lsblk -o NAME $NVME_DEVICE | grep -c "p[0-9]" | tail -n1)"

print_message "Создан раздел для Arch Linux: $ARCH_PART"

# Форматирование раздела в btrfs
print_message "Форматирование раздела $ARCH_PART в btrfs..."
mkfs.btrfs -f -L ArchLinux $ARCH_PART

# Монтирование разделов
print_message "Монтирование разделов..."
mount $ARCH_PART /mnt

# Создание директории для EFI
mkdir -p /mnt/boot

# Поиск и монтирование EFI раздела
EFI_PART=$(lsblk -o NAME,FSTYPE,PARTTYPE $NVME_DEVICE | grep -B1 -E "vfat|fat32" | grep "c12a7328-f81f-11d2-ba4b-00a0c93ec93b" | awk '{print $1}')
if [ -n "$EFI_PART" ]; then
    EFI_DEVICE="/dev/$(echo $EFI_PART | head -n1 | sed 's/├─//g' | sed 's/└─//g')"
    print_message "Найден EFI раздел: $EFI_DEVICE"
    mount $EFI_DEVICE /mnt/boot
else
    print_error "EFI раздел не найден"
    exit 1
fi

# Выбор лучших зеркал (Россия)
print_message "Настройка лучших российских зеркал..."
cat > /etc/pacman.d/mirrorlist << EOF
## Russia
Server = https://mirror.yandex.ru/archlinux/\$repo/os/\$arch
Server = https://mirror.truenetwork.ru/archlinux/\$repo/os/\$arch
Server = https://mirrors.krasinfo.ru/archlinux/\$repo/os/\$arch
Server = https://mirror.nw-sys.ru/archlinux/\$repo/os/\$arch
Server = https://mirror.cedalan.ru/archlinux/\$repo/os/\$arch
Server = https://mirror.katya.ru/archlinux/\$repo/os/\$arch
Server = https://mirror.surf/archlinux/\$repo/os/\$arch
Server = https://mirrors.tuna.tsinghua.edu.cn/archlinux/\$repo/os/\$arch
Server = https://mirrors.aliyun.com/archlinux/\$repo/os/\$arch
Server = https://mirror.0xem.ma/arch/\$repo/os/\$arch
EOF

# Установка основных пакетов
print_message "Установка базовой системы..."
pacstrap /mnt base base-devel linux linux-firmware btrfs-progs nano sudo networkmanager plasma-meta konsole dolphin sddm firefox ark kate gwenview okular spectacle kcalc ktorrent kdenlive k3b neofetch htop git wget curl

# Генерация fstab
print_message "Генерация fstab..."
genfstab -U /mnt >> /mnt/etc/fstab

# Chroot и настройка системы
print_message "Настройка системы в chroot..."
arch-chroot /mnt /bin/bash << EOF

# Установка часового пояса (Москва)
ln -sf /usr/share/zoneinfo/Europe/Moscow /etc/localtime
hwclock --systohc

# Локализация
echo "ru_RU.UTF-8 UTF-8" >> /etc/locale.gen
echo "en_US.UTF-8 UTF-8" >> /etc/locale.gen
locale-gen
echo "LANG=ru_RU.UTF-8" > /etc/locale.conf
echo "KEYMAP=ru" > /etc/vconsole.conf
echo "FONT=cyr-sun16" >> /etc/vconsole.conf

# Настройка хоста
echo "ArchLinux" > /etc/hostname
cat > /etc/hosts << HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   ArchLinux.localdomain ArchLinux
HOSTS

# Создание пользователя
useradd -m -G wheel,audio,video,storage,power -s /bin/bash DrDiablo
echo "DrDiablo:w" | chpasswd
echo "root:w" | chpasswd

# Настройка sudo
echo "%wheel ALL=(ALL:ALL) NOPASSWD: ALL" >> /etc/sudoers

# Настройка systemd-boot
bootctl install

# Создание загрузочной записи
cat > /boot/loader/entries/arch.conf << BOOT
title Arch Linux
linux /vmlinuz-linux
initrd /initramfs-linux.img
options root=LABEL=ArchLinux rw quiet
BOOT

# Настройка загрузчика
cat > /boot/loader/loader.conf << LOADER
default arch.conf
timeout 4
console-mode max
editor yes
LOADER

# Добавление Windows в загрузчик
if [ -f "/boot/EFI/Microsoft/Boot/bootmgfw.efi" ]; then
    cat > /boot/loader/entries/windows.conf << WIN
title Windows
efi /EFI/Microsoft/Boot/bootmgfw.efi
WIN
fi

# Добавление репозиториев
# archlinuxcn
echo "[archlinuxcn]" >> /etc/pacman.conf
echo "Server = https://mirrors.tuna.tsinghua.edu.cn/archlinuxcn/\$arch" >> /etc/pacman.conf

# chaotic-aur
pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com
pacman-key --lsign-key 3056513887B78AEB
pacman -U 'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst' --noconfirm
pacman -U 'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst' --noconfirm
echo "[chaotic-aur]" >> /etc/pacman.conf
echo "Include = /etc/pacman.d/chaotic-mirrorlist" >> /etc/pacman.conf

# blackarch
curl -O https://blackarch.org/strap.sh
chmod +x strap.sh
./strap.sh
rm strap.sh

# Обновление и установка AUR помощника
pacman -Syyu --noconfirm
pacman -S --noconfirm yay paru

# Настройка автологина SDDM
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/autologin.conf << SDDM
[Autologin]
User=DrDiablo
Session=plasma
SDDM

# Включение сервисов
systemctl enable NetworkManager
systemctl enable sddm
systemctl enable fstrim.timer

# Создание пустого скрипта в автозагрузку
mkdir -p /home/DrDiablo/.config/autostart
cat > /home/DrDiablo/.config/autostart/myscript.desktop << DESKTOP
[Desktop Entry]
Type=Application
Name=MyScript
Exec=/home/DrDiablo/myscript.sh
Hidden=false
NoDisplay=false
X-GNOME-Autostart-enabled=true
DESKTOP

touch /home/DrDiablo/myscript.sh
chmod +x /home/DrDiablo/myscript.sh
chown DrDiablo:DrDiablo /home/DrDiablo/myscript.sh
chown -R DrDiablo:DrDiablo /home/DrDiablo/.config

EOF

# Размонтирование
print_message "Размонтирование разделов..."
umount -R /mnt

print_message "Установка завершена! Система будет перезагружена через 10 секунд..."
sleep 10

# Перезагрузка
print_message "Перезагрузка..."
reboot
