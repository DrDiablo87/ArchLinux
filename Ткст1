#!/bin/bash

# Скрипт автоматической установки Arch Linux (Dual Boot с Windows)
# ВНИМАНИЕ! Скрипт требует прав root и работает без подтверждений

set -e  # Прерывать выполнение при любой ошибке

# Цвета для вывода
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo -e "${GREEN}Начинаем установку Arch Linux (Dual Boot с Windows)...${NC}"

# Проверка root прав
if [ "$EUID" -ne 0 ]; then 
    echo -e "${RED}Пожалуйста, запустите скрипт с правами root${NC}"
    exit 1
fi

# Проверка подключения к интернету
echo -e "${YELLOW}Проверка интернет-соединения...${NC}"
ping -c 3 archlinux.org || { echo -e "${RED}Нет интернет-соединения${NC}"; exit 1; }

# Поиск NVMe диска
echo -e "${YELLOW}Поиск NVMe диска...${NC}"
TARGET_DISK=$(lsblk -o NAME,TYPE -l | grep -E "nvme[0-9]n[0-9]" | grep "disk" | head -n1 | awk '{print $1}')
if [ -z "$TARGET_DISK" ]; then
    echo -e "${RED}NVMe диск не найден${NC}"
    echo -e "${YELLOW}Доступные диски:${NC}"
    lsblk -o NAME,SIZE,TYPE,MODEL
    exit 1
fi
TARGET_DISK="/dev/$TARGET_DISK"
echo -e "${GREEN}Найден диск: $TARGET_DISK${NC}"

# Показываем текущую разметку
echo -e "${YELLOW}Текущая разметка диска:${NC}"
parted $TARGET_DISK print
lsblk $TARGET_DISK

# Поиск EFI раздела Windows
echo -e "${YELLOW}Поиск EFI раздела Windows...${NC}"
EFI_PART=$(lsblk -o NAME,PARTTYPE,LABEL -l | grep -B1 -i "EFI" | grep -E "nvme[0-9]n[0-9]p[0-9]" | head -n1 | awk '{print $1}')
if [ -z "$EFI_PART" ]; then
    # Альтернативный поиск
    EFI_PART=$(lsblk -o NAME,FSTYPE -l | grep -B1 "vfat" | grep -E "nvme[0-9]n[0-9]p[0-9]" | head -n1 | awk '{print $1}')
fi

if [ -z "$EFI_PART" ]; then
    echo -e "${RED}EFI раздел не найден. Убедитесь, что Windows установлен в UEFI режиме${NC}"
    exit 1
fi

EFI_PART="/dev/$EFI_PART"
echo -e "${GREEN}Найден EFI раздел: $EFI_PART${NC}"

# Находим последний раздел и конец диска
echo -e "${YELLOW}Анализ разделов для создания нового раздела Arch Linux...${NC}"

# Получаем размер диска в секторах
DISK_SIZE=$(blockdev --getsz $TARGET_DISK)
DISK_SIZE_MB=$((DISK_SIZE * 512 / 1024 / 1024))
echo -e "${GREEN}Размер диска: $DISK_SIZE_MB MB${NC}"

# Получаем информацию о последнем разделе
LAST_PART_INFO=$(parted $TARGET_DISK unit s print | grep -E "^ [0-9]" | tail -1)
if [ -z "$LAST_PART_INFO" ]; then
    # Если разделов нет, начинаем с 1MB
    START_SECTOR="2048s"
else
    # Извлекаем конечный сектор последнего раздела
    LAST_END=$(echo $LAST_PART_INFO | awk '{print $3}' | sed 's/s//')
    START_SECTOR=$((LAST_END + 1))"s"
fi

echo -e "${GREEN}Будем создавать раздел начиная с сектора: $START_SECTOR${NC}"

# Получаем следующий номер раздела
PART_NUM=$(parted $TARGET_DISK print | grep -E "^ [0-9]" | wc -l)
NEW_PART_NUM=$((PART_NUM + 1))

# Создание раздела
echo -e "${YELLOW}Создание нового раздела номер $NEW_PART_NUM для Arch Linux...${NC}"
parted -s $TARGET_DISK mkpart primary $START_SECTOR 100%

# Определяем имя нового раздела
if [[ $TARGET_DISK == *"nvme"* ]]; then
    NEW_PART="${TARGET_DISK}p${NEW_PART_NUM}"
else
    NEW_PART="${TARGET_DISK}${NEW_PART_NUM}"
fi

# Ожидание появления раздела и обновление таблицы разделов
echo -e "${YELLOW}Ожидание создания раздела...${NC}"
sleep 3
partprobe $TARGET_DISK
sleep 2
udevadm settle

# Проверка создания раздела
if [ ! -e $NEW_PART ]; then
    echo -e "${RED}Раздел $NEW_PART не создался${NC}"
    echo -e "${YELLOW}Доступные разделы:${NC}"
    lsblk $TARGET_DISK
    exit 1
fi

echo -e "${GREEN}Раздел $NEW_PART успешно создан${NC}"

# Форматирование в btrfs
echo -e "${YELLOW}Форматирование раздела в btrfs с меткой ArchLinux...${NC}"
mkfs.btrfs -f -L ArchLinux $NEW_PART

# Монтирование
echo -e "${YELLOW}Монтирование разделов...${NC}"
mount $NEW_PART /mnt

# Монтирование EFI раздела
mkdir -p /mnt/boot
mount $EFI_PART /mnt/boot

# Настройка зеркал (10 лучших русских)
echo -e "${YELLOW}Настройка зеркал...${NC}"
cat > /etc/pacman.d/mirrorlist << EOF
## Russia
Server = https://mirror.yandex.ru/archlinux/\$repo/os/\$arch
Server = https://mirror.kamt.ru/archlinux/\$repo/os/\$arch
Server = https://mirror.da39a.ru/archlinux/\$repo/os/\$arch
Server = https://mirrors.kernel.org/archlinux/\$repo/os/\$arch
Server = https://mirror.surf/archlinux/\$repo/os/\$arch
Server = https://mirror.truenetwork.ru/archlinux/\$repo/os/\$arch
Server = https://mirror.rol.ru/archlinux/\$repo/os/\$arch
Server = https://mirror.archlinux.site/\$repo/os/\$arch
Server = https://mirror.archlinux.ikoula.com/\$repo/os/\$arch
Server = https://mirrors.mit.edu/archlinux/\$repo/os/\$arch
EOF

# Установка базовой системы
echo -e "${YELLOW}Установка базовой системы...${NC}"
pacstrap -K /mnt base base-devel linux linux-zen linux-firmware btrfs-progs efibootmgr dosfstools

# Генерация fstab
echo -e "${YELLOW}Генерация fstab...${NC}"
genfstab -U /mnt >> /mnt/etc/fstab

# Подготовка chroot окружения
echo -e "${YELLOW}Настройка системы в chroot...${NC}"

cat > /mnt/install-chroot.sh << 'EOF'
#!/bin/bash

# Установка часового пояса
ln -sf /usr/share/zoneinfo/Europe/Moscow /etc/localtime
hwclock --systohc

# Локализация
sed -i 's/^#\(ru_RU.UTF-8\)/\1/' /etc/locale.gen
sed -i 's/^#\(en_US.UTF-8\)/\1/' /etc/locale.gen
locale-gen
echo "LANG=ru_RU.UTF-8" > /etc/locale.conf
echo "KEYMAP=ru" > /etc/vconsole.conf
echo "FONT=cyr-sun16" >> /etc/vconsole.conf

# Настройка сети
echo "archlinux" > /etc/hostname
cat > /etc/hosts << HOSTS
127.0.0.1   localhost
::1         localhost
127.0.1.1   archlinux.localdomain archlinux
HOSTS

# Установка systemd-boot в существующий EFI раздел
bootctl --path=/boot install

# Создание загрузочной записи для Arch Linux
cat > /boot/loader/entries/arch.conf << BOOT
title   Arch Linux
linux   /vmlinuz-linux
initrd  /initramfs-linux.img
options root=LABEL=ArchLinux rw quiet
BOOT

cat > /boot/loader/entries/arch-zen.conf << BOOT
title   Arch Linux Zen
linux   /vmlinuz-linux-zen
initrd  /initramfs-linux-zen.img
options root=LABEL=ArchLinux rw quiet
BOOT

# Создание загрузочной записи для Windows
if [ -f /boot/EFI/Microsoft/Boot/bootmgfw.efi ]; then
    cat > /boot/loader/entries/windows.conf << WINDOWS
title   Windows 11
efi     /EFI/Microsoft/Boot/bootmgfw.efi
WINDOWS
    echo -e "${GREEN}Добавлена загрузочная запись для Windows${NC}"
fi

# Настройка загрузчика
cat > /boot/loader/loader.conf << LOADER
default arch.conf
timeout 4
console-mode max
editor no
LOADER

# Установка KDE minimal (без kde-network-meta)
pacman -S --noconfirm plasma-desktop sddm konsole dolphin kate \
    plasma-nm plasma-pa powerdevil kdeplasma-addons \
    kdegraphics-thumbnailers kio-extras ffmpegthumbs \
    ark gwenview spectacle

# Включение SDDM
systemctl enable sddm

# Создание пользователя
useradd -m -G wheel,audio,video,storage,power -s /bin/bash DrDiablo
echo "DrDiablo:w" | chpasswd

# Автологин в SDDM
mkdir -p /etc/sddm.conf.d
cat > /etc/sddm.conf.d/autologin.conf << SDDM
[Autologin]
User=DrDiablo
Session=plasma.desktop
SDDM

# Настройка sudo для группы wheel
sed -i 's/^# %wheel ALL=(ALL:ALL) ALL/%wheel ALL=(ALL:ALL) ALL/' /etc/sudoers

# Установка nano вместо vim
pacman -S --noconfirm nano
echo "EDITOR=nano" >> /etc/environment

# Добавление репозиториев
# archlinuxcn
cat >> /etc/pacman.conf << CN
[archlinuxcn]
Server = https://repo.archlinuxcn.org/\$arch
CN

# chaotic-aur
pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com
pacman-key --lsign-key 3056513887B78AEB
pacman -U --noconfirm 'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst'
pacman -U --noconfirm 'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst'

cat >> /etc/pacman.conf << CHAOTIC
[chaotic-aur]
Include = /etc/pacman.d/chaotic-mirrorlist
CHAOTIC

# Обновление баз данных
pacman -Syy --noconfirm

# Установка AUR helper (yay)
pacman -S --noconfirm yay

# Создание пустого скрипта в автозагрузку
mkdir -p /home/DrDiablo/.config/autostart
cat > /home/DrDiablo/.config/autostart/myscript.desktop << DESKTOP
[Desktop Entry]
Type=Application
Name=MyScript
Exec=/home/DrDiablo/myscript.sh
X-GNOME-Autostart-enabled=true
DESKTOP

touch /home/DrDiablo/myscript.sh
chmod +x /home/DrDiablo/myscript.sh
chown -R DrDiablo:DrDiablo /home/DrDiablo


# Обновление initramfs
mkinitcpio -P

pacman -S  gtkmm-4.0 gtkmm3 open-vm-tools --noconfirm
systemctl enable vmtoolsd.service

EOF

chmod +x /mnt/install-chroot.sh
arch-chroot /mnt /install-chroot.sh

# Очистка
rm /mnt/install-chroot.sh

# Размонтирование
echo -e "${YELLOW}Завершение установки...${NC}"
umount -R /mnt

echo -e "${GREEN}Установка завершена! Система настроена для dual boot с Windows.${NC}"
echo -e "${YELLOW}Логин: DrDiablo, Пароль: w${NC}"
echo -e "${YELLOW}Создан раздел: $NEW_PART${NC}"
echo -e "${YELLOW}Используется существующий EFI раздел: $EFI_PART${NC}"
echo -e "${YELLOW}При загрузке вы сможете выбрать между Arch Linux и Windows${NC}"

systemctl reboot
