#!/bin/bash

# Цвета для вывода
RED='\033[31m'
GREEN='\033[32m'
BLUE='\033[34m'
NC='\033[0m'

# Функция для цветного вывода
print_message() {
    echo -e "${GREEN}$1${NC}"
}

print_error() {
    echo -e "${RED}$1${NC}"
}

# Начальная настройка
sed -i 's/#ParallelDownloads = 5/ParallelDownloads = 10/g' /etc/pacman.conf
loadkeys ru
setfont cyr-sun16

# Синхронизация системных часов
timedatectl set-ntp true

clear
# ASCII арт (сокращен для читаемости, можно вернуть полный)
print_message "================================================================================"
print_message "                   Arch Linux Installation Script"
print_message "================================================================================"

# Ввод параметров
print_message ""
read -p "Введите имя компьютера: " hostname
read -p "Введите имя пользователя: " username
read -s -p "Введите пароль root: " rootpass
echo ""
read -s -p "Введите пароль пользователя: " userpass
echo ""

export hostname username rootpass userpass

# Выбор типа установки
print_message ""
echo "Выберите тип установки:"
echo "1 - Arch Linux (чистая установка)"
echo "2 - Arch Linux рядом с Windows"
read -p "Ваш выбор (1/2): " OS

# Определение диска
DISK="/dev/nvme0n1"
if [ ! -e "$DISK" ]; then
    # Пробуем найти другой NVMe диск
    for disk in /dev/nvme*n1; do
        if [ -e "$disk" ]; then
            DISK="$disk"
            break
        fi
    done
fi

print_message "Используется диск: $DISK"

# Создание разделов
print_message "================================================================================"
print_message "                     Создание разделов диска"
print_message "================================================================================"

if [[ $OS == 1 ]]; then
    # Чистая установка - удаляем все разделы
    print_message "Очистка диска и создание разделов для чистой установки..."
    wipefs -a "$DISK"
    
    (
        echo g                      # создаем таблицу разделов GPT
        echo n                      # новый раздел
        echo 1                      # номер раздела 1
        echo                        # первый сектор по умолчанию
        echo +200M                   # размер 200M для EFI
        echo t                      # изменение типа раздела
        echo 1                      # тип EFI
        echo n                      # новый раздел
        echo 2                      # номер раздела 2
        echo                        # первый сектор по умолчанию
        echo                        # последний сектор по умолчанию (весь оставшийся диск)
        echo w                      # запись изменений
    ) | fdisk --color=never "$DISK" > /dev/null 2>&1
    
    ROOT_PART="${DISK}p2"
    EFI_PART="${DISK}p1"
    
elif [[ $OS == 2 ]]; then
    # Установка рядом с Windows - создаем только root раздел
    print_message "Создание раздела для Arch Linux рядом с Windows..."
    
    # Находим последний раздел и добавляем после него
    LAST_SECTOR=$(fdisk -l "$DISK" | tail -n 1 | awk '{print $3}')
    if [ -z "$LAST_SECTOR" ]; then
        LAST_SECTOR=""
    fi
    
    (
        echo n                      # новый раздел
        echo                        # номер по умолчанию (следующий доступный)
        echo $LAST_SECTOR            # начинаем с последнего сектора + 1 (или пусто для авто)
        echo                        # используем все доступное пространство
        echo w                      # запись изменений
    ) | fdisk --color=never "$DISK" > /dev/null 2>&1
    
    # Определяем номер созданного раздела
    PART_NUM=$(fdisk -l "$DISK" | grep -c "^${DISK}p" | tail -n1)
    ROOT_PART="${DISK}p${PART_NUM}"
    EFI_PART=$(ls "${DISK}"p* | grep -E "p1$" | head -1)
    
    if [ ! -e "$EFI_PART" ]; then
        print_error "Не найден EFI раздел! Убедитесь, что Windows установлена в режиме UEFI."
        exit 1
    fi
else
    print_error "Неверный выбор"
    exit 1
fi

# Показываем созданную разметку
print_message "Созданная разметка диска:"
lsblk -f "$DISK"

# Форматирование разделов
print_message "================================================================================"
print_message "                     Форматирование разделов"
print_message "================================================================================"

# Форматирование EFI раздела (только если это чистая установка или раздел не от Windows)
if [[ $OS == 1 ]] || [[ ! $(blkid -o value -s TYPE "$EFI_PART" 2>/dev/null) == "vfat" ]]; then
    print_message "Форматирование EFI раздела..."
    mkfs.fat -F32 "$EFI_PART"
else
    print_message "Используется существующий EFI раздел Windows"
fi

# Форматирование root раздела
print_message "Форматирование root раздела в BTRFS..."
mkfs.btrfs -f -L ArchLinux "$ROOT_PART"

# Монтирование и создание подтомов BTRFS
print_message "================================================================================"
print_message "                     Создание подтомов BTRFS"
print_message "================================================================================"

# Монтируем root раздел
mount -t btrfs "$ROOT_PART" /mnt

# Создаем подтома
btrfs subvolume create /mnt/@
btrfs subvolume create /mnt/@home
btrfs subvolume create /mnt/@snapshots
btrfs subvolume create /mnt/@var_log
btrfs subvolume create /mnt/@var_cache

# Отмонтируем
umount /mnt

# Монтируем подтома с оптимальными параметрами
print_message "Монтирование подтомов..."
mount -t btrfs -o noatime,compress=zstd:3,ssd,space_cache=v2,subvol=@ "$ROOT_PART" /mnt

# Создаем директории
mkdir -p /mnt/{home,boot,.snapshots,var/log,var/cache}

# Монтируем остальные подтома
mount -t btrfs -o noatime,compress=zstd:3,ssd,space_cache=v2,subvol=@home "$ROOT_PART" /mnt/home
mount -t btrfs -o noatime,compress=zstd:3,ssd,space_cache=v2,subvol=@snapshots "$ROOT_PART" /mnt/.snapshots
mount -t btrfs -o noatime,compress=zstd:3,ssd,space_cache=v2,subvol=@var_log "$ROOT_PART" /mnt/var/log
mount -t btrfs -o noatime,compress=zstd:3,ssd,space_cache=v2,subvol=@var_cache "$ROOT_PART" /mnt/var/cache

# Монтируем EFI раздел
mount "$EFI_PART" /mnt/boot

# Установка базовой системы
print_message "================================================================================"
print_message "                     Установка базовой системы"
print_message "================================================================================"

# Обновление зеркал
reflector --country Russia --age 12 --protocol https --sort rate --save /etc/pacman.d/mirrorlist
pacman -Sy --noconfirm

# Установка основных пакетов
pacstrap /mnt base base-devel linux linux-zen linux-firmware \
    linux-headers linux-zen-headers btrfs-progs \
    nano vim amd-ucode intel-ucode \
    iwd networkmanager dhcpcd \
    git wget curl reflector \
    efibootmgr grub os-prober

# Генерация fstab
print_message "================================================================================"
print_message "                     Генерация fstab"
print_message "================================================================================"
genfstab -U /mnt >> /mnt/etc/fstab

# Исправляем fstab для подтомов BTRFS
sed -i 's/subvolid=[0-9]*,//g' /mnt/etc/fstab

# Настройка системы внутри chroot
print_message "================================================================================"
print_message "                     Настройка системы"
print_message "================================================================================"

cat > /mnt/arch-chroot-setup.sh << 'INNEREOF'
#!/bin/bash

# Цвета
GREEN='\033[32m'
NC='\033[0m'

echo -e "${GREEN}Настройка базовых параметров системы...${NC}"

# Имя компьютера
echo "$hostname" > /etc/hostname

# Временная зона
ln -sf /usr/share/zoneinfo/Europe/Moscow /etc/localtime
hwclock --systohc

# Локализация
echo "en_US.UTF-8 UTF-8" > /etc/locale.gen
echo "ru_RU.UTF-8 UTF-8" >> /etc/locale.gen
locale-gen

echo 'LANG="ru_RU.UTF-8"' > /etc/locale.conf
echo "KEYMAP=ru" > /etc/vconsole.conf
echo "FONT=cyr-sun16" >> /etc/vconsole.conf

# Настройка mkinitcpio
echo 'MODULES=() 
BINARIES=() 
FILES=() 
HOOKS="base udev autodetect modconf block filesystems keyboard keymap"' > /etc/mkinitcpio.conf

# Обновление initramfs
mkinitcpio -P

# Пользователи и пароли
echo -e "${GREEN}Установка паролей...${NC}"
echo -e "$rootpass\n$rootpass" | passwd

useradd -m -G wheel,storage,power,audio,video -s /bin/bash "$username"
echo -e "$userpass\n$userpass" | passwd "$username"

# Sudo настройки
echo "%wheel ALL=(ALL:ALL) ALL" > /etc/sudoers.d/wheel
echo "$username ALL=(ALL) NOPASSWD: /usr/bin/systemctl" >> /etc/sudoers.d/wheel
chmod 440 /etc/sudoers.d/wheel

# Загрузчик
echo -e "${GREEN}Установка загрузчика...${NC}"

if [ -d /sys/firmware/efi ]; then
    # UEFI установка
    bootctl install
    
    # Определяем root раздел
    ROOT_UUID=$(blkid -s UUID -o value /dev/disk/by-label/ArchLinux)
    
    # Создание загрузочных записей
    cat > /boot/loader/entries/arch.conf << EOF
title   Arch Linux
linux   /vmlinuz-linux
initrd  /amd-ucode.img
initrd  /initramfs-linux.img
options root=UUID=$ROOT_UUID rw rootflags=subvol=@ quiet splash
EOF

    cat > /boot/loader/entries/arch-zen.conf << EOF
title   Arch Linux Zen
linux   /vmlinuz-linux-zen
initrd  /amd-ucode.img
initrd  /initramfs-linux-zen.img
options root=UUID=$ROOT_UUID rw rootflags=subvol=@ quiet splash
EOF

    # Настройка loader.conf
    cat > /boot/loader/loader.conf << EOF
default arch.conf
timeout 3
console-mode max
editor no
EOF

else
    # BIOS установка
    pacman -S grub --noconfirm
    grub-install --target=i386-pc "$DISK"
    grub-mkconfig -o /boot/grub/grub.cfg
fi

# Сеть
echo -e "${GREEN}Настройка сети...${NC}"
systemctl enable NetworkManager
systemctl enable systemd-resolved

# Hosts файл
cat > /etc/hosts << EOF
127.0.0.1   localhost
::1         localhost
127.0.1.1   $hostname.localdomain $hostname
EOF

# Дополнительные репозитории
echo -e "${GREEN}Добавление дополнительных репозиториев...${NC}"

# Chaotic AUR
pacman-key --recv-key 3056513887B78AEB --keyserver keyserver.ubuntu.com
pacman-key --lsign-key 3056513887B78AEB
pacman -U 'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-keyring.pkg.tar.zst' --noconfirm
pacman -U 'https://cdn-mirror.chaotic.cx/chaotic-aur/chaotic-mirrorlist.pkg.tar.zst' --noconfirm

# Arch Linux CN
cat >> /etc/pacman.conf << EOF

[archlinuxcn]
Server = https://repo.archlinuxcn.org/\$arch
SigLevel = Never

[chaotic-aur]
Include = /etc/pacman.d/chaotic-mirrorlist
SigLevel = Never
EOF

# Обновление системы
pacman -Syu --noconfirm

# Установка графической среды (опционально)
echo -e "${GREEN}Установка KDE Plasma...${NC}"
pacman -S --noconfirm xorg sddm plasma plasma-wayland-session \
    kde-applications firefox firefox-i18n-ru \
    ark p7zip unrar unzip zip \
    telegram-desktop vlc mpv \
    noto-fonts noto-fonts-cjk noto-fonts-emoji ttf-dejavu ttf-liberation \
    pipewire pipewire-alsa pipewire-pulse pipewire-jack wireplumber \
    ntfs-3g exfat-utils dosfstools \
    git python python-pip nodejs npm \
    htop btop neofetch

# Видеодрайверы (определяем автоматически)
GPU=$(lspci | grep -E "VGA|3D")
if echo "$GPU" | grep -qi "nvidia"; then
    pacman -S --noconfirm nvidia nvidia-utils nvidia-settings
elif echo "$GPU" | grep -qi "amd"; then
    pacman -S --noconfirm mesa xf86-video-amdgpu vulkan-radeon libva-mesa-driver
elif echo "$GPU" | grep -qi "intel"; then
    pacman -S --noconfirm mesa xf86-video-intel vulkan-intel
fi

# Включение сервисов
systemctl enable sddm
systemctl enable NetworkManager
systemctl enable bluetooth
systemctl enable fstrim.timer

# Настройка SDDM для автологина
cat > /etc/sddm.conf.d/autologin.conf << EOF
[Autologin]
User=$username
Session=plasma
EOF

# Права для пользователя
usermod -aG wheel,storage,power,audio,video,lp,network,wireshark "$username"

# Оптимизация BTRFS
systemctl enable fstrim.timer

# Настройка zram (опционально)
pacman -S --noconfirm zram-generator
cat > /etc/systemd/zram-generator.conf << EOF
[zram0]
zram-size = min(ram / 2, 4096)
compression-algorithm = zstd
EOF

# Очистка
rm /arch-chroot-setup.sh

echo -e "${GREEN}Базовая настройка завершена!${NC}"
INNEREOF

# Делаем скрипт исполняемым
chmod +x /mnt/arch-chroot-setup.sh

# Передаем переменные и выполняем в chroot
arch-chroot /mnt /bin/bash -c "hostname='$hostname' username='$username' rootpass='$rootpass' userpass='$userpass' DISK='$DISK' /arch-chroot-setup.sh"

# Проверка на ошибки
if [ $? -ne 0 ]; then
    print_error "Ошибка при настройке системы!"
    exit 1
fi

# Очистка
rm /mnt/arch-chroot-setup.sh

print_message "================================================================================"
print_message "        Установка завершена! Система будет перезагружена через 5 секунд"
print_message "================================================================================"
sleep 5

# Перезагрузка
if [[ $OS == 2 ]]; then
    systemctl reboot --firmware-setup
else
    systemctl reboot
fi
